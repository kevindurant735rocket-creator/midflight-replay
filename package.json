{
  "name": "midflight-replay",
  "version": "0.1.2",
  "private": false,
  "description": "Turn a finished AI coding-agent session into a scrubbable, single-file HTML replay you can attach to a PR. Zero deps, zero build, zero network.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "midflight": "dist/cli.js",
    "midflight-replay": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "fixtures/cursor-mini.jsonl",
    "fixtures/windsurf-cascade-empty.pb",
    "fixtures/windsurf-cascade-mini.pb",
    "fixtures/windsurf-cascade-plaintext.pb",
    "fixtures/codex-mini.jsonl",
    "fixtures/claude-mini.jsonl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:links && npm run build && npm run check:readme",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "node dist/cli.js doctor fixtures/codex-mini.jsonl --json",
    "check:links": "node scripts/link-check.mjs README.md README.zh-CN.md CONTRIBUTING.md CHANGELOG.md docs/*.md docs/ISSUES/*.md",
    "check:readme": "node scripts/readme-commands.mjs",
    "verify:tarball": "bash scripts/verify-tarball.sh",
    "smoke:real": "node scripts/real-log-smoke.mjs",
    "smoke:real:ci": "node scripts/real-log-smoke.mjs --limit 40",
    "smoke:browser:real": "node scripts/browser-real-hosts.mjs",
    "check:repo": "node scripts/verify-repo-settings.mjs",
    "check:claims": "node scripts/verify-claims.mjs",
    "acceptance": "bash scripts/acceptance.sh"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevindurant735rocket-creator/midflight-replay.git"
  },
  "homepage": "https://github.com/kevindurant735rocket-creator/midflight-replay#readme",
  "bugs": {
    "url": "https://github.com/kevindurant735rocket-creator/midflight-replay/issues"
  },
  "author": "kevindurant735rocket-creator",
  "types": "dist/types.d.ts",
  "keywords": [
    "ai-agent",
    "codex",
    "claude-code",
    "replay",
    "forensics",
    "postmortem",
    "observability",
    "session-log",
    "jsonl",
    "pr-review",
    "developer-tools",
    "cli"
  ]
}
